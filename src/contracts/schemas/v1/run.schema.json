{
  "$defs": {
    "RunState": {
      "enum": [
        "DETECTED",
        "CONTEXT_ASSEMBLING",
        "CONTEXT_ASSEMBLED",
        "POLICY_VERIFIED",
        "EVIDENCE_HOLD",
        "AWAITING_APPROVAL",
        "ESCALATED",
        "APPROVED",
        "EXECUTING",
        "EXECUTION_FAILED",
        "EXECUTED",
        "CLOSED_REJECTED"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "$id": "https://schemas.innexq.invalid/v1/run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_id": {
      "minLength": 1,
      "title": "Contract Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "current_brief_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Brief Hash"
    },
    "current_brief_version": {
      "default": 0,
      "minimum": 0,
      "title": "Current Brief Version",
      "type": "integer"
    },
    "owner_user_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner User Id"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "contract_id",
    "state",
    "created_at",
    "updated_at",
    "correlation_id"
  ],
  "title": "Run",
  "type": "object"
}
