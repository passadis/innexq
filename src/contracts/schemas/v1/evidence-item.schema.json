{
  "$defs": {
    "ActorContext": {
      "additionalProperties": false,
      "properties": {
        "actor_user_id": {
          "minLength": 1,
          "title": "Actor User Id",
          "type": "string"
        },
        "authorization_mode": {
          "$ref": "#/$defs/AuthorizationMode"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "actor_user_id",
        "tenant_id",
        "authorization_mode"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "AuthorizationMode": {
      "enum": [
        "delegated",
        "workload_identity"
      ],
      "title": "AuthorizationMode",
      "type": "string"
    },
    "Classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "foundry_iq",
        "work_iq",
        "tool"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.innexq.invalid/v1/evidence-item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_context": {
      "$ref": "#/$defs/ActorContext"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "excerpt": {
      "minLength": 1,
      "title": "Excerpt",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "source_locator": {
      "minLength": 1,
      "title": "Source Locator",
      "type": "string"
    },
    "source_name": {
      "minLength": 1,
      "title": "Source Name",
      "type": "string"
    },
    "supports_claim_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Supports Claim Ids",
      "type": "array"
    }
  },
  "required": [
    "evidence_id",
    "source_kind",
    "source_name",
    "source_locator",
    "excerpt",
    "retrieved_at",
    "actor_context",
    "supports_claim_ids",
    "classification"
  ],
  "title": "EvidenceItem",
  "type": "object"
}
