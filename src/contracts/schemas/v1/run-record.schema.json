{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "artifact_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Hash",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 200,
          "minLength": 16,
          "title": "Idempotency Key",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "action_id",
        "action_type",
        "parameters",
        "artifact_hash",
        "idempotency_key"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionManifest": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "brief_version": {
          "minimum": 1,
          "title": "Brief Version",
          "type": "integer"
        },
        "manifest_id": {
          "format": "uuid",
          "title": "Manifest Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "manifest_id",
        "run_id",
        "brief_version",
        "actions"
      ],
      "title": "ActionManifest",
      "type": "object"
    },
    "ActionType": {
      "enum": [
        "sharepoint.create_file",
        "graph.send_mail",
        "teams.send_status"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "ActorContext": {
      "additionalProperties": false,
      "properties": {
        "actor_user_id": {
          "minLength": 1,
          "title": "Actor User Id",
          "type": "string"
        },
        "authorization_mode": {
          "$ref": "#/$defs/AuthorizationMode"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "actor_user_id",
        "tenant_id",
        "authorization_mode"
      ],
      "title": "ActorContext",
      "type": "object"
    },
    "AgentProposal": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "citations"
      ],
      "title": "AgentProposal",
      "type": "object"
    },
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "option_id": {
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "required_scenario_role": {
          "minLength": 1,
          "title": "Required Scenario Role",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "description",
        "required_scenario_role"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "ApprovalDecision": {
      "additionalProperties": false,
      "properties": {
        "actor_user_id": {
          "minLength": 1,
          "title": "Actor User Id",
          "type": "string"
        },
        "authority_result": {
          "$ref": "#/$defs/AuthorityResult"
        },
        "brief_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Brief Hash",
          "type": "string"
        },
        "brief_version": {
          "minimum": 1,
          "title": "Brief Version",
          "type": "integer"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "run_id",
        "brief_version",
        "brief_hash",
        "actor_user_id",
        "decision",
        "authority_result",
        "submitted_at"
      ],
      "title": "ApprovalDecision",
      "type": "object"
    },
    "AuthorityResult": {
      "additionalProperties": false,
      "properties": {
        "actor_scenario_role": {
          "minLength": 1,
          "title": "Actor Scenario Role",
          "type": "string"
        },
        "required_scenario_role": {
          "minLength": 1,
          "title": "Required Scenario Role",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/AuthorityVerdict"
        }
      },
      "required": [
        "verdict",
        "actor_scenario_role",
        "required_scenario_role",
        "rule_id",
        "rule_version"
      ],
      "title": "AuthorityResult",
      "type": "object"
    },
    "AuthorityVerdict": {
      "enum": [
        "authorized",
        "unauthorized",
        "escalation_required"
      ],
      "title": "AuthorityVerdict",
      "type": "string"
    },
    "AuthorizationMode": {
      "enum": [
        "delegated",
        "workload_identity"
      ],
      "title": "AuthorizationMode",
      "type": "string"
    },
    "CalculationRecord": {
      "additionalProperties": false,
      "properties": {
        "calculation_id": {
          "format": "uuid",
          "title": "Calculation Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Outputs",
          "type": "object"
        },
        "tool_name": {
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "calculation_id",
        "tool_name",
        "tool_version",
        "inputs",
        "outputs"
      ],
      "title": "CalculationRecord",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "title",
        "excerpt",
        "url"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "approve",
        "reject",
        "edit",
        "escalate"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DecisionBrief": {
      "additionalProperties": false,
      "properties": {
        "action_manifest_id": {
          "format": "uuid",
          "title": "Action Manifest Id",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "brief_version": {
          "minimum": 1,
          "title": "Brief Version",
          "type": "integer"
        },
        "calculations": {
          "items": {
            "$ref": "#/$defs/CalculationRecord"
          },
          "minItems": 1,
          "title": "Calculations",
          "type": "array"
        },
        "evidence_gaps": {
          "items": {
            "$ref": "#/$defs/EvidenceGap"
          },
          "title": "Evidence Gaps",
          "type": "array"
        },
        "material_claims": {
          "items": {
            "$ref": "#/$defs/MaterialClaim"
          },
          "minItems": 1,
          "title": "Material Claims",
          "type": "array"
        },
        "policy_checks": {
          "items": {
            "$ref": "#/$defs/PolicyCheck"
          },
          "minItems": 1,
          "title": "Policy Checks",
          "type": "array"
        },
        "presentation": {
          "$ref": "#/$defs/Presentation"
        },
        "recommendation": {
          "$ref": "#/$defs/Recommendation"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "brief_version",
        "recommendation",
        "alternatives",
        "material_claims",
        "calculations",
        "policy_checks",
        "evidence_gaps",
        "action_manifest_id",
        "presentation"
      ],
      "title": "DecisionBrief",
      "type": "object"
    },
    "EvidenceGap": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "gap_id": {
          "format": "uuid",
          "title": "Gap Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceGapKind"
        },
        "required_resolution": {
          "minLength": 1,
          "title": "Required Resolution",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "kind",
        "description",
        "required_resolution"
      ],
      "title": "EvidenceGap",
      "type": "object"
    },
    "EvidenceGapKind": {
      "enum": [
        "missing",
        "stale",
        "conflicting",
        "inaccessible"
      ],
      "title": "EvidenceGapKind",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "actor_context": {
          "$ref": "#/$defs/ActorContext"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_locator": {
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "source_name": {
          "minLength": 1,
          "title": "Source Name",
          "type": "string"
        },
        "supports_claim_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supports Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "source_kind",
        "source_name",
        "source_locator",
        "excerpt",
        "retrieved_at",
        "actor_context",
        "supports_claim_ids",
        "classification"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "JsonValue": {},
    "MaterialClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_ids"
      ],
      "title": "MaterialClaim",
      "type": "object"
    },
    "PolicyCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "format": "uuid",
          "title": "Check Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "required_scenario_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Scenario Role"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/PolicyVerdict"
        }
      },
      "required": [
        "check_id",
        "rule_id",
        "rule_version",
        "verdict",
        "evidence_ids",
        "explanation"
      ],
      "title": "PolicyCheck",
      "type": "object"
    },
    "PolicyVerdict": {
      "enum": [
        "pass",
        "fail",
        "requires_approval"
      ],
      "title": "PolicyVerdict",
      "type": "string"
    },
    "Presentation": {
      "additionalProperties": false,
      "properties": {
        "customer_language_drafts": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Customer Language Drafts",
          "type": "object"
        },
        "detailed_summary": {
          "minLength": 1,
          "title": "Detailed Summary",
          "type": "string"
        },
        "plain_language_summary": {
          "minLength": 1,
          "title": "Plain Language Summary",
          "type": "string"
        }
      },
      "required": [
        "plain_language_summary",
        "detailed_summary",
        "customer_language_drafts"
      ],
      "title": "Presentation",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "service_level": {
          "minLength": 1,
          "title": "Service Level",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "term_months": {
          "exclusiveMinimum": 0,
          "title": "Term Months",
          "type": "integer"
        }
      },
      "required": [
        "option_id",
        "term_months",
        "service_level",
        "summary"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "minLength": 1,
          "title": "Contract Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "current_brief_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Brief Hash"
        },
        "current_brief_version": {
          "default": 0,
          "minimum": 0,
          "title": "Current Brief Version",
          "type": "integer"
        },
        "owner_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner User Id"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "pattern": "^1\\.0$",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "contract_id",
        "state",
        "created_at",
        "updated_at",
        "correlation_id"
      ],
      "title": "Run",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "DETECTED",
        "CONTEXT_ASSEMBLING",
        "CONTEXT_ASSEMBLED",
        "POLICY_VERIFIED",
        "EVIDENCE_HOLD",
        "AWAITING_APPROVAL",
        "ESCALATED",
        "APPROVED",
        "EXECUTING",
        "EXECUTION_FAILED",
        "EXECUTED",
        "CLOSED_REJECTED"
      ],
      "title": "RunState",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "foundry_iq",
        "work_iq",
        "tool"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "VersionedBrief": {
      "additionalProperties": false,
      "properties": {
        "action_manifest": {
          "$ref": "#/$defs/ActionManifest"
        },
        "brief": {
          "$ref": "#/$defs/DecisionBrief"
        },
        "brief_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Brief Hash",
          "type": "string"
        }
      },
      "required": [
        "brief",
        "action_manifest",
        "brief_hash"
      ],
      "title": "VersionedBrief",
      "type": "object"
    }
  },
  "$id": "https://schemas.innexq.invalid/v1/run-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_status": {
      "additionalProperties": {
        "enum": [
          "started",
          "completed",
          "unknown"
        ],
        "type": "string"
      },
      "title": "Action Status",
      "type": "object"
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_requested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Requested At"
    },
    "envelope": {
      "anyOf": [
        {
          "$ref": "#/$defs/VersionedBrief"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "facts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Facts",
      "type": "object"
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "receipts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Receipts",
      "type": "object"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "run": {
      "$ref": "#/$defs/Run"
    },
    "workflow_pack": {
      "const": "contract-renewal",
      "default": "contract-renewal",
      "title": "Workflow Pack",
      "type": "string"
    }
  },
  "required": [
    "run",
    "revision"
  ],
  "title": "RunRecord",
  "type": "object"
}
