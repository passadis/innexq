{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "artifact_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Hash",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 200,
          "minLength": 16,
          "title": "Idempotency Key",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "action_id",
        "action_type",
        "parameters",
        "artifact_hash",
        "idempotency_key"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionType": {
      "enum": [
        "sharepoint.create_file",
        "graph.send_mail",
        "teams.send_status"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "JsonValue": {}
  },
  "$id": "https://schemas.innexq.invalid/v1/action-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "brief_version": {
      "minimum": 1,
      "title": "Brief Version",
      "type": "integer"
    },
    "manifest_id": {
      "format": "uuid",
      "title": "Manifest Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "run_id",
    "brief_version",
    "actions"
  ],
  "title": "ActionManifest",
  "type": "object"
}
