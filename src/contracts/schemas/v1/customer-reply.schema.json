{
  "$defs": {
    "CustomerCitation": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Document Version",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "value": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "document_version",
        "page",
        "label",
        "value"
      ],
      "title": "CustomerCitation",
      "type": "object"
    }
  },
  "$id": "https://schemas.innexq.invalid/v1/customer-reply.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of"
    },
    "can_confirm": {
      "default": false,
      "title": "Can Confirm",
      "type": "boolean"
    },
    "citations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CustomerCitation"
      },
      "maxItems": 30,
      "title": "Citations",
      "type": "array"
    },
    "equipment_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "pattern": "^DEMO-[A-Z0-9-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Equipment Id"
    },
    "intent": {
      "enum": [
        "certificate_request",
        "service_status",
        "certificate_status",
        "service_request",
        "service_document_request",
        "coverage_renewal",
        "general",
        "clarify"
      ],
      "title": "Intent",
      "type": "string"
    },
    "kind": {
      "enum": [
        "answer",
        "clarification",
        "confirmation_required",
        "unsupported"
      ],
      "title": "Kind",
      "type": "string"
    },
    "message": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "message_id": {
      "format": "uuid",
      "title": "Message Id",
      "type": "string"
    }
  },
  "required": [
    "message_id",
    "intent",
    "equipment_id",
    "kind",
    "message"
  ],
  "title": "CustomerReply",
  "type": "object"
}
