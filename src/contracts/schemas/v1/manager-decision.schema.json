{
  "$id": "https://schemas.innexq.invalid/v1/manager-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_object_id": {
      "minLength": 1,
      "title": "Actor Object Id",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "operations_decision_id": {
      "format": "uuid",
      "title": "Operations Decision Id",
      "type": "string"
    },
    "operations_note_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operations Note Sha256"
    },
    "package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Hash",
      "type": "string"
    },
    "package_version": {
      "minimum": 1,
      "title": "Package Version",
      "type": "integer"
    },
    "reject_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reject Reason"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "request_id",
    "package_version",
    "package_hash",
    "actor_object_id",
    "decision",
    "operations_decision_id",
    "submitted_at"
  ],
  "title": "ManagerDecision",
  "type": "object"
}
