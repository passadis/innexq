{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "option_id": {
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "required_scenario_role": {
          "minLength": 1,
          "title": "Required Scenario Role",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "description",
        "required_scenario_role"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "CalculationRecord": {
      "additionalProperties": false,
      "properties": {
        "calculation_id": {
          "format": "uuid",
          "title": "Calculation Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Outputs",
          "type": "object"
        },
        "tool_name": {
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "calculation_id",
        "tool_name",
        "tool_version",
        "inputs",
        "outputs"
      ],
      "title": "CalculationRecord",
      "type": "object"
    },
    "EvidenceGap": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "gap_id": {
          "format": "uuid",
          "title": "Gap Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceGapKind"
        },
        "required_resolution": {
          "minLength": 1,
          "title": "Required Resolution",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "kind",
        "description",
        "required_resolution"
      ],
      "title": "EvidenceGap",
      "type": "object"
    },
    "EvidenceGapKind": {
      "enum": [
        "missing",
        "stale",
        "conflicting",
        "inaccessible"
      ],
      "title": "EvidenceGapKind",
      "type": "string"
    },
    "JsonValue": {},
    "MaterialClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_ids"
      ],
      "title": "MaterialClaim",
      "type": "object"
    },
    "PolicyCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "format": "uuid",
          "title": "Check Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "required_scenario_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Scenario Role"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/PolicyVerdict"
        }
      },
      "required": [
        "check_id",
        "rule_id",
        "rule_version",
        "verdict",
        "evidence_ids",
        "explanation"
      ],
      "title": "PolicyCheck",
      "type": "object"
    },
    "PolicyVerdict": {
      "enum": [
        "pass",
        "fail",
        "requires_approval"
      ],
      "title": "PolicyVerdict",
      "type": "string"
    },
    "Presentation": {
      "additionalProperties": false,
      "properties": {
        "customer_language_drafts": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Customer Language Drafts",
          "type": "object"
        },
        "detailed_summary": {
          "minLength": 1,
          "title": "Detailed Summary",
          "type": "string"
        },
        "plain_language_summary": {
          "minLength": 1,
          "title": "Plain Language Summary",
          "type": "string"
        }
      },
      "required": [
        "plain_language_summary",
        "detailed_summary",
        "customer_language_drafts"
      ],
      "title": "Presentation",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "service_level": {
          "minLength": 1,
          "title": "Service Level",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "term_months": {
          "exclusiveMinimum": 0,
          "title": "Term Months",
          "type": "integer"
        }
      },
      "required": [
        "option_id",
        "term_months",
        "service_level",
        "summary"
      ],
      "title": "Recommendation",
      "type": "object"
    }
  },
  "$id": "https://schemas.innexq.invalid/v1/decision-brief.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_manifest_id": {
      "format": "uuid",
      "title": "Action Manifest Id",
      "type": "string"
    },
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "brief_version": {
      "minimum": 1,
      "title": "Brief Version",
      "type": "integer"
    },
    "calculations": {
      "items": {
        "$ref": "#/$defs/CalculationRecord"
      },
      "minItems": 1,
      "title": "Calculations",
      "type": "array"
    },
    "evidence_gaps": {
      "items": {
        "$ref": "#/$defs/EvidenceGap"
      },
      "title": "Evidence Gaps",
      "type": "array"
    },
    "material_claims": {
      "items": {
        "$ref": "#/$defs/MaterialClaim"
      },
      "minItems": 1,
      "title": "Material Claims",
      "type": "array"
    },
    "policy_checks": {
      "items": {
        "$ref": "#/$defs/PolicyCheck"
      },
      "minItems": 1,
      "title": "Policy Checks",
      "type": "array"
    },
    "presentation": {
      "$ref": "#/$defs/Presentation"
    },
    "recommendation": {
      "$ref": "#/$defs/Recommendation"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "brief_version",
    "recommendation",
    "alternatives",
    "material_claims",
    "calculations",
    "policy_checks",
    "evidence_gaps",
    "action_manifest_id",
    "presentation"
  ],
  "title": "DecisionBrief",
  "type": "object"
}
