{
  "$defs": {
    "AuthorityResult": {
      "additionalProperties": false,
      "properties": {
        "actor_scenario_role": {
          "minLength": 1,
          "title": "Actor Scenario Role",
          "type": "string"
        },
        "required_scenario_role": {
          "minLength": 1,
          "title": "Required Scenario Role",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/AuthorityVerdict"
        }
      },
      "required": [
        "verdict",
        "actor_scenario_role",
        "required_scenario_role",
        "rule_id",
        "rule_version"
      ],
      "title": "AuthorityResult",
      "type": "object"
    },
    "AuthorityVerdict": {
      "enum": [
        "authorized",
        "unauthorized",
        "escalation_required"
      ],
      "title": "AuthorityVerdict",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "approve",
        "reject",
        "edit",
        "escalate"
      ],
      "title": "Decision",
      "type": "string"
    }
  },
  "$id": "https://schemas.innexq.invalid/v1/approval-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_user_id": {
      "minLength": 1,
      "title": "Actor User Id",
      "type": "string"
    },
    "authority_result": {
      "$ref": "#/$defs/AuthorityResult"
    },
    "brief_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Brief Hash",
      "type": "string"
    },
    "brief_version": {
      "minimum": 1,
      "title": "Brief Version",
      "type": "integer"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "submitted_at": {
      "format": "date-time",
      "title": "Submitted At",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "run_id",
    "brief_version",
    "brief_hash",
    "actor_user_id",
    "decision",
    "authority_result",
    "submitted_at"
  ],
  "title": "ApprovalDecision",
  "type": "object"
}
