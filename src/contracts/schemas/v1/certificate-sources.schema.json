{
  "$defs": {
    "CertificateInvestigation": {
      "additionalProperties": false,
      "properties": {
        "extraction_api": {
          "const": "2024-11-30",
          "default": "2024-11-30",
          "title": "Extraction Api",
          "type": "string"
        },
        "extraction_model": {
          "const": "prebuilt-layout",
          "default": "prebuilt-layout",
          "title": "Extraction Model",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/DocumentFieldProof"
          },
          "title": "Fields",
          "type": "array"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "specialists": {
          "items": {
            "$ref": "#/$defs/SpecialistProof"
          },
          "title": "Specialists",
          "type": "array"
        },
        "tool_activity": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceToolActivity"
          },
          "title": "Tool Activity",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "fields",
        "specialists"
      ],
      "title": "CertificateInvestigation",
      "type": "object"
    },
    "CertificateSource": {
      "additionalProperties": false,
      "properties": {
        "accessible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accessible"
        },
        "customer_id": {
          "minLength": 1,
          "title": "Customer Id",
          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "minLength": 1,
          "title": "Document Version",
          "type": "string"
        },
        "equipment_id": {
          "minLength": 1,
          "title": "Equipment Id",
          "type": "string"
        },
        "fresh_until": {
          "format": "date-time",
          "title": "Fresh Until",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "revoked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revoked"
        },
        "serial_number": {
          "minLength": 1,
          "title": "Serial Number",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "source_version",
        "observed_at",
        "fresh_until",
        "customer_id",
        "equipment_id",
        "serial_number",
        "document_id",
        "document_version",
        "sha256",
        "valid_from",
        "valid_until",
        "accessible",
        "revoked"
      ],
      "title": "CertificateSource",
      "type": "object"
    },
    "DocumentFieldProof": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_version": {
          "minLength": 1,
          "title": "Document Version",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "polygon": {
          "items": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "maxItems": 64,
          "minItems": 8,
          "title": "Polygon",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "document_version",
        "sha256",
        "label",
        "value",
        "page",
        "polygon"
      ],
      "title": "DocumentFieldProof",
      "type": "object"
    },
    "EvidenceToolActivity": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "specialist": {
          "enum": [
            "document_analyst",
            "equipment_service"
          ],
          "title": "Specialist",
          "type": "string"
        },
        "tool_name": {
          "enum": [
            "get_equipment_record",
            "list_equipment_documents",
            "analyze_document",
            "retrieve_policy"
          ],
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "receipt_id",
        "specialist",
        "tool_name",
        "source_version",
        "completed_at"
      ],
      "title": "EvidenceToolActivity",
      "type": "object"
    },
    "OwnershipSource": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "minLength": 1,
          "title": "Customer Id",
          "type": "string"
        },
        "equipment_id": {
          "minLength": 1,
          "title": "Equipment Id",
          "type": "string"
        },
        "fresh_until": {
          "format": "date-time",
          "title": "Fresh Until",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "serial_number": {
          "minLength": 1,
          "title": "Serial Number",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        }
      },
      "required": [
        "source_version",
        "observed_at",
        "fresh_until",
        "customer_id",
        "equipment_id",
        "serial_number"
      ],
      "title": "OwnershipSource",
      "type": "object"
    },
    "ServiceSource": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "minLength": 1,
          "title": "Customer Id",
          "type": "string"
        },
        "equipment_id": {
          "minLength": 1,
          "title": "Equipment Id",
          "type": "string"
        },
        "fresh_until": {
          "format": "date-time",
          "title": "Fresh Until",
          "type": "string"
        },
        "in_service": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "In Service"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "serial_number": {
          "minLength": 1,
          "title": "Serial Number",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        }
      },
      "required": [
        "source_version",
        "observed_at",
        "fresh_until",
        "customer_id",
        "equipment_id",
        "serial_number",
        "valid_from",
        "valid_until",
        "in_service"
      ],
      "title": "ServiceSource",
      "type": "object"
    },
    "SpecialistProof": {
      "additionalProperties": false,
      "properties": {
        "response_id": {
          "minLength": 1,
          "title": "Response Id",
          "type": "string"
        },
        "specialist": {
          "enum": [
            "request_coordinator",
            "document_analyst",
            "equipment_service"
          ],
          "title": "Specialist",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "specialist",
        "response_id",
        "summary"
      ],
      "title": "SpecialistProof",
      "type": "object"
    }
  },
  "$id": "https://schemas.innexq.invalid/v1/certificate-sources.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Trusted adapters supply facts; agents do not supply executable verdicts.",
  "properties": {
    "certificate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CertificateSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "investigation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CertificateInvestigation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ownership": {
      "anyOf": [
        {
          "$ref": "#/$defs/OwnershipSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "service": {
      "anyOf": [
        {
          "$ref": "#/$defs/ServiceSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "CertificateSources",
  "type": "object"
}
