{
  "$defs": {
    "RunState": {
      "enum": [
        "DETECTED",
        "CONTEXT_ASSEMBLING",
        "CONTEXT_ASSEMBLED",
        "POLICY_VERIFIED",
        "EVIDENCE_HOLD",
        "AWAITING_APPROVAL",
        "ESCALATED",
        "APPROVED",
        "EXECUTING",
        "EXECUTION_FAILED",
        "EXECUTED",
        "CLOSED_REJECTED"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "$id": "https://schemas.innexq.invalid/v1/run-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_user_id": {
      "title": "Actor User Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "details": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Details",
      "type": "object"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "correlation_id",
    "sequence",
    "event_type",
    "state",
    "occurred_at",
    "actor_user_id"
  ],
  "title": "RunEvent",
  "type": "object"
}
